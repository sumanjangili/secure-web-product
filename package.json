{
  "name": "@sumanjangili/app-indoscient",
  "version": "1.2.0",
  "description": "Secure web product with MFA, rate limiting, and encrypted data storage.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "functions": "netlify/functions"
  },
  "scripts": {
    "test": "npm run test:frontend && npm run test:functions",
    "validate": "node scripts/validate-env.js",
    "start": "npm run validate && netlify dev",
    "dev": "concurrently \"npm run dev:functions\" \"npm run dev:frontend\"",
    "dev:functions": "netlify functions:serve",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test:frontend": "npm --prefix frontend run test:run",
    "test:functions": "npm --prefix frontend exec -- vitest run --root ../netlify/functions --passWithNoTests",
    "lint": "npm run lint:frontend && npm run lint:functions",
    "lint:frontend": "cd frontend && eslint .",
    "lint:functions": "eslint \"netlify/functions/**/*.js\"",
    "type-check": "npm run type-check:frontend && npm run type-check:functions",
    "type-check:frontend": "cd frontend && tsc --noEmit",
    "type-check:functions": "tsc --noEmit -p netlify/functions",
    "audit": "npm run audit:frontend && npm run audit:functions",
    "audit:frontend": "cd frontend && npx audit-ci --moderate",
    "audit:functions": "cd netlify/functions && npm audit --omit=dev"
  },
  "keywords": [
    "security",
    "mfa",
    "encryption",
    "netlify",
    "postgres"
  ],
  "author": "Suman Jangili",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanjangili/secure-web-product.git"
  },
  "bugs": {
    "url": "https://github.com/sumanjangili/secure-web-product/issues"
  },
  "homepage": "https://app.indoscient.in",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@upstash/redis": "^1.41.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "toml": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "audit-ci": "^7.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "netlify-cli": "^27.16.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@esbuild/android-arm": "npm:@esbuild/darwin-arm64@latest",
    "glob": "^14.0.4",
    "minimatch": "^11.0.1"
  }
}
