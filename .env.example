# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ===== AUTH =====
JWT_SECRET=your-32-character-plus-secret-key-here-change-in-production
JWT_EXPIRY=24h

# ===== REDIS (Upstash) =====
UPSTASH_REDIS_REST_URL=https://your-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ===== SECURITY =====
NODE_ENV=development
NETLIFY_SITE_ID=your-site-id-if-known

# ===== CSRF PROTECTION =====
CSRF_SECRET=another-random-32-character-string
